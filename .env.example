# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit or share the real one.

FYERS_CLIENT_ID=your-client-id-here
FYERS_SECRET_KEY=your-secret-key-here
FYERS_REDIRECT_URI=http://127.0.0.1/

# This one changes daily -- update it after running login.py + get_token.py
# each morning (or whenever your token expires), no need to touch the rest.
FYERS_ACCESS_TOKEN=your-access-token-here
